---
import Lightbox from '../components/Lightbox.astro';
import Loader from '../components/Loader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getSiteSettings, resolveSiteTokens } from '../data/content';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const rawSettings = await getSiteSettings();
const settings = resolveSiteTokens(rawSettings, rawSettings);
const { title, description, imageAlt = settings.default_og_image.alt, noindex = false } = Astro.props;
const image = Astro.props.image || settings.default_og_image.src;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const siteUrl = new URL('/', Astro.site).toString();
const organizationId = new URL('/#organization', Astro.site).toString();
const homeStructuredData = Astro.url.pathname === '/' ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).toString(),
      url: siteUrl,
      name: settings.brand_name,
      alternateName: 'sidelineaction.be',
      inLanguage: 'nl-BE',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: settings.brand_name,
      url: siteUrl,
      description: settings.footer.tagline,
      logo: new URL('/assets/brand/logo-stacked.svg', Astro.site).toString(),
      email: settings.contact.email,
      areaServed: settings.region_full,
      sameAs: [settings.contact.instagram_url, settings.contact.tiktok_url],
    },
  ],
} : null;
const extraStructuredData = Astro.props.structuredData
  ? (Array.isArray(Astro.props.structuredData) ? Astro.props.structuredData : [Astro.props.structuredData])
  : [];
const structuredData = [homeStructuredData, ...extraStructuredData].filter(Boolean) as Record<string, unknown>[];
const serializeStructuredData = (value: Record<string, unknown>) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="nl" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={settings.photographer_name} />
    <meta name="theme-color" content="#FCFBF9" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Inter:wght@400;450;500;600&display=swap" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:site_name" content={settings.brand_name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {structuredData.map((item) => (
      <script type="application/ld+json" set:html={serializeStructuredData(item)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Naar de inhoud</a>
    <Loader />
    <SiteHeader currentPath={Astro.url.pathname} settings={settings} />
    <slot />
    <SiteFooter settings={settings} />
    <Lightbox />
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/lightbox.ts"></script>
    <script src="../scripts/booking.ts"></script>
  </body>
</html>
