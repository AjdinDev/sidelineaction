---
import type { SiteSettings } from '../data/content';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
---

<footer class="sa-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/assets/brand/logo-stacked.svg" alt={settings.brand_name} width="300" height="100" />
        </div>
        <p class="footer-tag">{settings.footer.tagline}</p>
      </div>
      <div class="footer-col">
        <h2>{settings.footer.navigation_heading}</h2>
        <ul>
          <li><a href="/portfolio">{settings.navigation.portfolio}</a></li>
          <li><a href="/diensten">{settings.navigation.services}</a></li>
          <li><a href="/aanbod">{settings.navigation.offer}</a></li>
          <li><a href="/over-mij">{settings.navigation.about}</a></li>
          <li><a href="/contact">{settings.navigation.contact}</a></li>
          <li><a href="/boeken">{settings.navigation.booking}</a></li>
          <li><a href="/samenwerking">{settings.navigation.collaboration}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h2>{settings.footer.contact_heading}</h2>
        <ul>
          <li><a href={`mailto:${settings.contact.email}`}>{settings.contact.email}</a></li>
          <li><a href={settings.contact.instagram_url} target="_blank" rel="noopener noreferrer">Instagram</a></li>
          <li><a href={settings.contact.tiktok_url} target="_blank" rel="noopener noreferrer">TikTok</a></li>
          <li style="color:var(--muted);font-size:.9375rem;margin-top:1rem">{settings.photographer_name}</li>
          <li style="color:var(--muted-2);font-size:.9375rem">{settings.region}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {settings.brand_name}</span>
      <span><a href="/samenwerking">{settings.footer.collaboration_label}</a></span>
    </div>
  </div>
</footer>
