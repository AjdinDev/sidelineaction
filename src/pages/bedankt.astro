---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bedankt voor je aanvraag | Sideline Action" description="Bedankt voor je aanvraag bij Sideline Action.">
  <main id="main">
    <section class="section" style="padding-top:calc(var(--header-h) + clamp(5rem, 4rem + 7vw, 10rem));min-height:68svh">
      <div class="wrap wrap--text">
        <p class="label label--rule">Verzonden</p>
        <h1 class="h1 mt-3" data-reveal>Bedankt.</h1>
        <p class="lead mt-3" data-reveal="fade">Je aanvraag is verzonden. Ik neem zo snel mogelijk contact met je op.</p>
        <p class="muted mt-3" data-reveal="fade">Geen antwoord gekregen binnen enkele dagen? Stuur dan gerust een mail naar <a href="mailto:harunviteskic50@gmail.com" style="color:var(--ink)">harunviteskic50@gmail.com</a>.</p>
        <div class="btn-row mt-4" data-reveal>
          <a class="btn " href="/portfolio"><span>Bekijk het portfolio</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a>
          <a class="link " href="/">Terug naar home<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
