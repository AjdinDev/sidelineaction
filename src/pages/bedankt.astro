---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings, getThanksPage, resolveSiteTokens } from '../data/content';

const settings = await getSiteSettings();
const page = resolveSiteTokens(await getThanksPage(), settings);
const emailStart = page.follow_up_text.indexOf(settings.contact.email);
const followUpBefore = emailStart >= 0 ? page.follow_up_text.slice(0, emailStart) : page.follow_up_text;
const followUpAfter = emailStart >= 0 ? page.follow_up_text.slice(emailStart + settings.contact.email.length) : '';
---

<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image}>
  <main id="main">
    <section class="section" style="padding-top:calc(var(--header-h) + clamp(5rem, 4rem + 7vw, 10rem));min-height:68svh">
      <div class="wrap wrap--text">
        <p class="label label--rule">{page.label}</p>
        <h1 class="h1 mt-3" data-reveal>{page.title}</h1>
        <p class="lead mt-3" data-reveal="fade">{page.text}</p>
        <p class="muted mt-3" data-reveal="fade">
          {followUpBefore}
          {emailStart >= 0 && <a href={`mailto:${settings.contact.email}`} style="color:var(--ink)">{settings.contact.email}</a>}
          {followUpAfter}
        </p>
        <div class="btn-row mt-4" data-reveal>
          <a class="btn" href="/portfolio"><span>{page.portfolio_label}</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a>
          <a class="link" href="/">{page.home_label}<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
