---
import ContentCta from '../components/ContentCta.astro';
import FactsStrip from '../components/FactsStrip.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServicesPage, getSiteSettings, resolveSiteTokens } from '../data/content';

const settings = await getSiteSettings();
const page = resolveSiteTokens(await getServicesPage(), settings);
---

<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image}>
  <main id="main">
    <PageHeader {...page.header} />

    <section class="section section--top0">
      <div class="wrap">
        <div class="service-paths">
          {page.audiences.map((audience, index) => (
            <article class="service-path" data-reveal style={`--reveal-delay:${index * 90}ms`}>
              <span class="service-path__n">{String(index + 1).padStart(2, '0')}</span>
              <h2>{audience.title}</h2>
              <p>{audience.text}</p>
              <a class="link" href="/boeken">
                {audience.link_label}
                <svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--top0">
      <div class="wrap">
        <div class="split split--top" style="margin-bottom:clamp(2.5rem, 2rem + 3vw, 4.5rem)">
          <div>
            <p class="label label--rule">{page.gallery.label}</p>
            <h2 class="h2 mt-2" data-reveal>{page.gallery.title}</h2>
          </div>
          <p class="muted measure" data-reveal="fade">{page.gallery.intro}</p>
        </div>
        <div class="cols cols--2">
          {page.gallery.items.map((item, index) => (
            <article data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <div data-reveal="mask">
                <div class={`ratio ${index % 2 === 0 ? 'ratio--45' : 'ratio--34'} zoom`}>
                  <img src={item.image.src} alt={item.image.alt} width="900" height="1350" loading="lazy" decoding="async" />
                </div>
              </div>
              <div class="mt-3" style="padding-top:1.25rem;border-top:1px solid var(--line)">
                <h2 class="h3">{item.title}</h2>
                <p class="mt-1">{item.summary}</p>
                <p class="muted mt-1" style="font-size:.9688rem">{item.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split split--top" style="margin-bottom:clamp(2.5rem, 2rem + 3vw, 4.5rem)">
          <div>
            <p class="label label--rule">{page.process.label}</p>
            <h2 class="h2 mt-2" data-reveal>{page.process.title}</h2>
          </div>
          <div data-reveal="fade"><p class="muted measure">{page.process.intro}</p></div>
        </div>
        <div class="index">
          {page.process.steps.map((step, index) => (
            <div class="index__row" data-reveal>
              <span class="index__n">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="index__title">{step.title}</h3>
              <p class="index__text">{step.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FactsStrip {...page.facts} />
    <ContentCta content={page.cta} />
  </main>
</BaseLayout>
