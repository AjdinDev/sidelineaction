---
import ContentCta from '../components/ContentCta.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAboutPage, getSiteSettings, resolveSiteTokens } from '../data/content';

const settings = await getSiteSettings();
const page = resolveSiteTokens(await getAboutPage(), settings);
---

<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image}>
  <main id="main">
    <PageHeader {...page.header} />

    <section class="section section--top0">
      <div class="wrap">
        <div class="split">
          <div data-reveal="mask">
            <div class="ratio ratio--45">
              <img src={page.story.image.src} alt={page.story.image.alt} width="900" height="1350" loading="lazy" decoding="async" />
            </div>
          </div>
          <div class="prose">
            <p class="label label--rule">{page.story.label}</p>
            {page.story.paragraphs.map((paragraph, index) => (
              <p class={index === 0 ? 'lead mt-3' : 'muted mt-3'} data-reveal="fade">{paragraph}</p>
            ))}
            <div class="mt-4" data-reveal><a class="link" href="/portfolio">{page.story.link_label}<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split split--top">
          <div>
            <p class="label label--rule">{page.equipment.label}</p>
            <h2 class="h2 mt-2" data-reveal>{page.equipment.title}</h2>
            <p class="muted mt-3 measure" data-reveal="fade">{page.equipment.intro}</p>
          </div>
          <div class="index equipment-list" data-reveal="fade">
            {page.equipment.items.map((item, index) => (
              <div class="index__row" style="grid-template-columns:4rem minmax(0,1fr) auto">
                <span class="index__n">{String(index + 1).padStart(2, '0')}</span>
                <span class="index__title" style="font-size:1.0625rem">{item.name}</span>
                <span class="muted" style="font-size:.9375rem">{item.description}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section section--top0">
      <div class="wrap">
        <div class="split split--top" style="margin-bottom:clamp(2.5rem, 2rem + 3vw, 4.5rem)">
          <div>
            <p class="label label--rule">{page.process.label}</p>
            <h2 class="h2 mt-2" data-reveal>{page.process.title}</h2>
          </div>
          <div data-reveal="fade"><p class="muted measure">{page.process.intro}</p></div>
        </div>
        <div class="index">
          {page.process.steps.map((step, index) => (
            <div class="index__row" data-reveal>
              <span class="index__n">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="index__title">{step.title}</h3>
              <p class="index__text">{step.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ContentCta content={page.cta} />
  </main>
</BaseLayout>
