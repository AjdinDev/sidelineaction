---
import ContentCta from '../components/ContentCta.astro';
import FactsStrip from '../components/FactsStrip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomePage, getSiteSettings, resolveSiteTokens, slugFromContentReference } from '../data/content';
import { getPublishedShoots, photoAlt, preparePhoto } from '../data/shoots';

const [settings, rawPage, shoots] = await Promise.all([
  getSiteSettings(),
  getHomePage(),
  getPublishedShoots(),
]);
const page = resolveSiteTokens(rawPage, settings);
const featuredSlug = slugFromContentReference(page.featured.shoot);
const featuredShoot = shoots.find((shoot) => shoot.slug === featuredSlug);

if (!featuredShoot) {
  throw new Error(`De homepage verwijst naar een onbekende of niet-gepubliceerde shoot: ${page.featured.shoot}`);
}

const featuredIndices = page.featured.images.map((image) => (
  featuredShoot.photos.findIndex((photo) => photo.src === image.src)
));
if (featuredIndices.some((index) => index < 0)) {
  throw new Error(`De homepage bevat een uitgelichte foto die niet bij shoot "${featuredShoot.title}" hoort.`);
}
const featuredImages = await Promise.all(page.featured.images.map(preparePhoto));
---

<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image}>
  <main id="main">
    <section class="hero">
      <div class="hero__inner">
        <div class="hero__media">
          <img src={page.hero.image.src} fetchpriority="high" decoding="async" width="900" height="1350" alt={page.hero.image.alt} />
        </div>
        <div class="hero__body">
          <div class="wrap">
            <p class="label hero__eyebrow">{page.hero.eyebrow}</p>
            <h1 class="hero__title">
              {page.hero.title_lines.map((line, index) => (
                <><span><i style={`--d:${150 + index * 110}ms`}>{line}</i></span>{index < page.hero.title_lines.length - 1 && ' '}</>
              ))}
            </h1>
            <p class="hero__sub">{page.hero.subtitle}</p>
            <div class="hero__actions btn-row">
              <a class="btn btn--solid" href="/portfolio"><span>{page.hero.primary_label}</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a>
              <a class="btn" href="/boeken"><span>{page.hero.secondary_label}</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a>
            </div>
          </div>
        </div>
      </div>
      <span class="hero__meta" aria-hidden="true">{page.hero.meta}</span>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split split--top">
          <div>
            <p class="label label--rule">{page.intro.label}</p>
            <h2 class="h2 mt-2" data-reveal>{page.intro.title}</h2>
          </div>
          <div class="prose" data-reveal="fade">
            <p class="lead">{page.intro.lead}</p>
            <p class="muted mt-3">{page.intro.text}</p>
            <div class="mt-4"><a class="link" href="/over-mij">{page.intro.link_label}<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--top0">
      <div class="wrap">
        <div class="duo">
          {page.intro.images.map((image, index) => (
            <figure style={`margin:0;--reveal-delay:${index * 120}ms`} data-reveal="mask">
              <div class={`ratio ${index === 0 ? 'ratio--45' : 'ratio--34'} zoom`}>
                <img src={image.src} alt={image.alt} width="900" height="1350" loading="lazy" decoding="async" />
              </div>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="werk">
      <div class="wrap">
        <div class="split split--top" style="margin-bottom:clamp(3rem, 2rem + 4vw, 6rem)">
          <div>
            <p class="label label--rule">{page.featured.label}</p>
            <h2 class="h2 mt-2" data-reveal>{featuredShoot.title}.</h2>
          </div>
          <div data-reveal="fade">
            <p class="muted measure">{page.featured.text}</p>
            <div class="mt-4"><a class="link" href={`/portfolio/${featuredShoot.slug}`}>{page.featured.link_label}<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a></div>
          </div>
        </div>

        <figure class="feature" data-reveal="mask">
          <div class="ratio ratio--45 zoom">
            <img src={featuredImages[0].src} width={featuredImages[0].width} height={featuredImages[0].height} alt={photoAlt(featuredShoot, featuredIndices[0], settings.brand_name)} loading="lazy" decoding="async" />
          </div>
          <figcaption class="cap"><span class="cap-n">001</span><span>{page.featured.caption}</span></figcaption>
        </figure>

        <div class="duo mt-5">
          {featuredImages.slice(1).map((image, index) => (
            <figure style="margin:0" data-reveal="mask">
              <div class={`ratio ${index === 0 ? 'ratio--45' : 'ratio--34'} zoom`}>
                <img src={image.src} width={image.width} height={image.height} alt={photoAlt(featuredShoot, featuredIndices[index + 1], settings.brand_name)} loading="lazy" decoding="async" />
              </div>
            </figure>
          ))}
        </div>

        <div class="mt-5"><a class="link" href="/portfolio">{page.featured.portfolio_label}<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a></div>
      </div>
    </section>

    <section class="section section--top0 section--bot0">
      <div class="wrap wrap--full" style="padding-inline:0">
        <div data-reveal="mask">
          <div class="ratio ratio--169"><img src={page.band_image.src} alt={page.band_image.alt} width="900" height="600" loading="lazy" decoding="async" /></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split split--top" style="margin-bottom:clamp(2.5rem, 2rem + 3vw, 4.5rem)">
          <div>
            <p class="label label--rule">{page.services.label}</p>
            <h2 class="h2 mt-2" data-reveal>{page.services.title}</h2>
          </div>
          <div data-reveal="fade"><p class="muted measure">{page.services.text}</p></div>
        </div>
        <div class="index">
          {page.services.items.map((item, index) => (
            <div class="index__row" data-reveal style={`--reveal-delay:${index * 60}ms`}>
              <span class="index__n">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="index__title">{item.title}</h3>
              <p class="index__text">{item.text}</p>
            </div>
          ))}
        </div>
        <div class="mt-4"><a class="link" href="/diensten">{page.services.link_label}<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a></div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split">
          <div data-reveal="mask"><div class="ratio ratio--45"><img src={page.about.image.src} alt={page.about.image.alt} width="900" height="1350" loading="lazy" decoding="async" /></div></div>
          <div>
            <p class="label label--rule">{page.about.label}</p>
            <h2 class="h2 mt-2" data-reveal>{page.about.title}</h2>
            <div class="prose mt-3" data-reveal="fade">
              <p class="lead">{page.about.lead}</p>
              <p class="muted mt-3">{page.about.text}</p>
              <div class="mt-4"><a class="link" href="/over-mij">{page.about.link_label}<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <FactsStrip {...page.facts} />

    <section class="section">
      <div class="wrap">
        <div class="split split--top">
          <div>
            <p class="label label--rule">{page.offer.label}</p>
            <h2 class="h2 mt-2" data-reveal>{page.offer.title}</h2>
          </div>
          <div data-reveal="fade">
            <p class="muted measure">
              {page.offer.text}{' '}
              <a href={`mailto:${settings.contact.email}`}>{page.offer.email_label}</a>{' '}of neem contact op via{' '}
              <a href={settings.contact.instagram_url} target="_blank" rel="noopener noreferrer">{page.offer.instagram_label}</a>.
            </p>
            <div class="mt-4"><a class="link" href="/aanbod">{page.offer.link_label}<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a></div>
          </div>
        </div>
      </div>
    </section>

    <ContentCta content={page.booking} />

    <section class="section section--top0">
      <div class="wrap">
        <div class="split split--top">
          <div>
            <p class="label label--rule">{page.contact.label}</p>
            <h2 class="h2 mt-2" data-reveal>{page.contact.title_lines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</h2>
          </div>
          <ul class="contact-list" data-reveal="fade">
            <li><a href={`mailto:${settings.contact.email}`}><span class="k">E-mail</span><span class="v">{settings.contact.email}</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a></li>
            <li><a href={settings.contact.instagram_url} target="_blank" rel="noopener noreferrer"><span class="k">Instagram</span><span class="v">{settings.contact.instagram_handle}</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a></li>
            <li><a href={settings.contact.tiktok_url} target="_blank" rel="noopener noreferrer"><span class="k">TikTok</span><span class="v">{settings.contact.tiktok_handle}</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2" /></svg></a></li>
            <li><span class="row"><span class="k">Regio</span><span class="v">{settings.region}</span><span></span></span></li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
