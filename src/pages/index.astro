---
import ternesse002 from '../assets/portfolio/ternesse-002.webp';
import ternesse003 from '../assets/portfolio/ternesse-003.webp';
import ternesse004 from '../assets/portfolio/ternesse-004.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sideline Action | Voetbalfotografie voor clubs en spelers" description="Professionele, betaalbare voetbalbeelden voor clubs en individuele spelers in Antwerpen en omgeving.">
  <main id="main">
    <section class="hero">
      <div class="hero__inner">
          <div class="hero__media">
            <img src="/assets/img/site/hero.webp"
                 fetchpriority="high" decoding="async"
                 width="900" height="1350"
                 alt="Voetballer in een geel shirt dribbelt met de bal — foto door Harun Viteskic voor Sideline Action">
        </div>
        <div class="hero__body">
          <div class="wrap">
            <p class="label hero__eyebrow">Voetbalfotografie &mdash; voor clubs en spelers</p>
            <h1 class="hero__title">
              <span><i style="--d:150ms">Sideline</i></span>
              <span><i style="--d:260ms">Action</i></span>
            </h1>
            <p class="hero__sub">Professionele voetbalbeelden voor volledige clubs én individuele spelers.</p>
            <div class="hero__actions btn-row">
              <a class="btn btn--solid" href="/portfolio"><span>Bekijk portfolio</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a>
              <a class="btn " href="/boeken"><span>Boek een shoot</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a>
            </div>
          </div>
        </div>
      </div>
      <span class="hero__meta" aria-hidden="true">Harun Viteskic &mdash; Antwerpen</span>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split split--top">
          <div>
            <p class="label label--rule">Sideline Action</p>
            <h2 class="h2 mt-2" data-reveal>Voetbalfotografie voor clubs én individuele spelers.</h2>
          </div>
          <div class="prose" data-reveal="fade">
            <p class="lead">Boek een volledige wedstrijdreportage voor je club, of laat één speler gericht volgen tijdens een wedstrijd.</p>
            <p class="muted mt-3">Ik leg actie, duels, emoties en sfeer vast. Daarna selecteer en bewerk ik de sterkste beelden voor social media, websites en persoonlijke profielen.</p>
            <div class="mt-4"><a class="link " href="/over-mij">Over mij<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--top0">
      <div class="wrap">
        <div class="duo">
          <figure style="margin:0" data-reveal="mask">
            <div class="ratio ratio--45 zoom ">

              <img src="/assets/img/site/intro-1.webp"
                   alt="Duel om de bal tussen twee spelers tijdens een voetbalwedstrijd in Antwerpen" width="900" height="1350"
                   loading="lazy" decoding="async">
            </div>
          </figure>
          <figure style="margin:0;--reveal-delay:120ms" data-reveal="mask">
            <div class="ratio ratio--34 zoom ">

              <img src="/assets/img/site/intro-2.webp"
                   alt="Speler voor het doel tijdens een voetbalwedstrijd — Sideline Action" width="900" height="1350"
                   loading="lazy" decoding="async">
            </div>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="werk">
      <div class="wrap">
        <div class="split split--top" style="margin-bottom:clamp(3rem, 2rem + 4vw, 6rem)">
          <div>
            <p class="label label--rule">Portfolio</p>
            <h2 class="h2 mt-2" data-reveal>Ternesse.</h2>
          </div>
          <div data-reveal="fade">
            <p class="muted measure">Een volledige wedstrijd, van de opwarming tot het laatste fluitsignaal. Een uitgebreide selectie beelden, geselecteerd en afgewerkt.</p>
            <div class="mt-4"><a class="link " href="/portfolio/ternesse">Bekijk de shoot<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a></div>
          </div>
        </div>

        <figure class="feature" data-reveal="mask">
          <div class="ratio ratio--45 zoom ">

              <img src={ternesse002.src} width={ternesse002.width} height={ternesse002.height}
                     alt="Twee spelers schouder aan schouder in duel om de bal — Ternesse, Sideline Action"
                     loading="lazy" decoding="async">
            </div>
          <figcaption class="cap"><span class="cap-n">001</span><span>Duel om de bal, tweede helft.</span></figcaption>
        </figure>

        <div class="duo mt-5">
          <figure style="margin:0" data-reveal="mask">
            <div class="ratio ratio--45 zoom ">

              <img src={ternesse004.src} width={ternesse004.width} height={ternesse004.height}
                     alt="Speler trapt de bal vanaf de hoekschopstip — Ternesse, Sideline Action"
                     loading="lazy" decoding="async">
            </div>
          </figure>
          <figure style="margin:0" data-reveal="mask">
            <div class="ratio ratio--34 zoom ">

              <img src={ternesse003.src} width={ternesse003.width} height={ternesse003.height}
                     alt="Speler sprint met de bal richting het doel — Ternesse, Sideline Action"
                     loading="lazy" decoding="async">
            </div>
          </figure>
        </div>

        <div class="mt-5"><a class="link " href="/portfolio">Volledig portfolio<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a></div>
      </div>
    </section>

    <section class="section section--top0 section--bot0">
      <div class="wrap wrap--full" style="padding-inline:0">
        <div data-reveal="mask">
          <div class="ratio ratio--169  ">

              <img src="/assets/img/site/band-1.webp"
                   alt="Het team verzamelt rond de coach tijdens een voetbalwedstrijd in Antwerpen" width="900" height="600"
                   loading="lazy" decoding="async">
            </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split split--top" style="margin-bottom:clamp(2.5rem, 2rem + 3vw, 4.5rem)">
          <div>
            <p class="label label--rule">Diensten</p>
            <h2 class="h2 mt-2" data-reveal>Twee manieren om te boeken.</h2>
          </div>
          <div data-reveal="fade">
            <p class="muted measure">Of je nu namens een club boekt of als individuele speler: de fotografie blijft gericht op echte wedstrijdmomenten en een sterke, professionele selectie.</p>
          </div>
        </div>
        <div class="index">

          <div class="index__row" data-reveal style="--reveal-delay:0ms">
            <span class="index__n">01</span>
            <h3 class="index__title">Voor clubs</h3>
            <p class="index__text">Volledige wedstrijdfotografie met actie, spelers, teams, fans en sfeer voor sociale media, website en communicatie.</p>
          </div>
          <div class="index__row" data-reveal style="--reveal-delay:60ms">
            <span class="index__n">02</span>
            <h3 class="index__title">Voor spelers</h3>
            <p class="index__text">Persoonlijke actiefoto's van één speler tijdens een wedstrijd, bruikbaar voor Instagram, social media en een eigen sportprofiel.</p>
          </div>
          <div class="index__row" data-reveal style="--reveal-delay:120ms">
            <span class="index__n">03</span>
            <h3 class="index__title">Actie en sfeer</h3>
            <p class="index__text">Duels, sprints, schoten, emoties en de momenten langs de lijn die het verhaal compleet maken.</p>
          </div>
          <div class="index__row" data-reveal style="--reveal-delay:180ms">
            <span class="index__n">04</span>
            <h3 class="index__title">Professionele levering</h3>
            <p class="index__text">Een zorgvuldig geselecteerde en professioneel bewerkte reeks, zonder zware extra filters.</p>
          </div>
        </div>
        <div class="mt-4"><a class="link " href="/diensten">Alle diensten<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a></div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split">
          <div data-reveal="mask">
            <div class="ratio ratio--45  ">

              <img src="/assets/img/site/over-mij.webp"
                   alt="Speler aan de bal tijdens een voetbalwedstrijd in Antwerpen — Sideline Action" width="900" height="1350"
                   loading="lazy" decoding="async">
            </div>
          </div>
          <div>
            <p class="label label--rule">Over mij</p>
            <h2 class="h2 mt-2" data-reveal>Ik ben Harun Viteskic.</h2>
            <div class="prose mt-3" data-reveal="fade">
              <p class="lead">13 jaar oud, en serieus bezig met sportfotografie.</p>
              <p class="muted mt-3">Ik fotografeer vooral voetbalwedstrijden in Antwerpen en omgeving. Tijdens wedstrijden probeer ik zoveel mogelijk actie, spelers, fans en sfeer vast te leggen, en daaruit lever ik een sterke selectie goede beelden.</p>
              <div class="mt-4"><a class="link " href="/over-mij">Mijn verhaal en apparatuur<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a></div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <section class="section section--half">
      <div class="wrap">
        <p class="label label--rule">Bij een volledige wedstrijd</p>
        <div class="facts mt-4" data-reveal>
          <div>
            <div class="num">100&ndash;150</div>
            <p class="fact-label">Professioneel bewerkte foto's per wedstrijd. Minimaal 100.</p>
          </div>
          <div>
            <div class="num">5</div>
            <p class="fact-label">Dagen maximaal tussen de wedstrijd en de levering.</p>
          </div>
          <div>
            <div class="num">Digitaal</div>
            <p class="fact-label">Geleverd in volledige resolutie, meteen bruikbaar voor de clubkanalen.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split split--top">
          <div>
            <p class="label label--rule">Aanbod</p>
            <h2 class="h2 mt-2" data-reveal>Betaalbare sportfotografie, op maat van de opdracht.</h2>
          </div>
          <div data-reveal="fade">
            <p class="muted measure">Mijn tarieven liggen bewust lager dan bij veel professionele sportfotografen. Prijzen zijn bespreekbaar en afhankelijk van de opdracht. Benieuwd naar de prijs voor jouw wedstrijd of spelersshoot? <a href="mailto:harunviteskic50@gmail.com">Stuur een mailtje</a> of neem contact op via <a href="https://instagram.com/sidelineaction" target="_blank" rel="noopener noreferrer">Instagram</a>.</p>
            <div class="mt-4"><a class="link " href="/aanbod">Wat is inbegrepen<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a></div>
          </div>
        </div>
      </div>
    </section>


    <section class="section">
      <div class="wrap">
        <div class="split split--top">
          <div>
            <p class="label label--rule">Boeken</p>
            <h2 class="h2 mt-2" data-reveal>Klaar voor beelden van je club of van één speler?</h2>
            <p class="muted mt-3 measure" data-reveal="fade">Vertel kort om welke wedstrijd of opdracht het gaat. Ik neem zo snel mogelijk contact op met een voorstel en de afspraken.</p>
            <div class="btn-row mt-4" data-reveal>
              <a class="btn btn--solid" href="/boeken"><span>Boek een shoot</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a>
              <a class="link " href="/aanbod">Bekijk het aanbod<svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a>
            </div>
          </div>
          <div data-reveal="mask">
            <div class="ratio ratio--45 zoom ">

              <img src="/assets/img/site/band-cta.webp"
                   alt="Twee spelers in duel om de bal tijdens een voetbalwedstrijd in Antwerpen — Sideline Action" width="900" height="1350"
                   loading="lazy" decoding="async">
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--top0">
      <div class="wrap">
        <div class="split split--top">
          <div>
            <p class="label label--rule">Contact</p>
            <h2 class="h2 mt-2" data-reveal>Een vraag?<br>Stuur gerust een bericht.</h2>
          </div>
          <ul class="contact-list" data-reveal="fade">
            <li><a href="mailto:harunviteskic50@gmail.com"><span class="k">E-mail</span><span class="v">harunviteskic50@gmail.com</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a></li>
            <li><a href="https://instagram.com/sidelineaction" target="_blank" rel="noopener noreferrer"><span class="k">Instagram</span><span class="v">@sidelineaction</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a></li>
            <li><a href="https://www.tiktok.com/@sidelineaction" target="_blank" rel="noopener noreferrer"><span class="k">TikTok</span><span class="v">@sidelineaction</span><svg class="btn-arrow" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true"><path d="M10.5 1L14 4.5L10.5 8M14 4.5H0" stroke="currentColor" stroke-width="1.2"/></svg></a></li>
            <li><span class="row"><span class="k">Regio</span><span class="v">Antwerpen en omgeving</span><span></span></span></li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
