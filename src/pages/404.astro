---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNotFoundPage, getSiteSettings, resolveSiteTokens } from '../data/content';

const settings = await getSiteSettings();
const page = resolveSiteTokens(await getNotFoundPage(), settings);
---

<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image} noindex>
  <main id="main">
    <section class="section" style="padding-top:calc(var(--header-h) + clamp(5rem, 4rem + 7vw, 10rem));min-height:68svh">
      <div class="wrap wrap--text">
        <p class="label label--rule">{page.label}</p>
        <h1 class="h1 mt-3">{page.title}</h1>
        <p class="lead mt-3">{page.text}</p>
        <div class="btn-row mt-4">
          <a class="btn btn--solid" href="/"><span>{page.primary_label}</span></a>
          <a class="link" href="/portfolio">{page.secondary_label}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
