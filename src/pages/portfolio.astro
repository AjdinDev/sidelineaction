---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCta from '../components/ContentCta.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPortfolioPage, getSiteSettings, resolveSiteTokens } from '../data/content';
import { formatShootDate, getPublishedShoots, photoAlt, preparePhoto } from '../data/shoots';

const [publishedShoots, settings, rawPage] = await Promise.all([
  getPublishedShoots(),
  getSiteSettings(),
  getPortfolioPage(),
]);
const page = resolveSiteTokens(rawPage, settings);
const shootCards = await Promise.all(publishedShoots.map(async (shoot) => ({
  shoot,
  cover: await preparePhoto(shoot.cover),
})));
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={page.seo.image}
>
  <main id="main">
    <PageHeader {...page.header} />

    <section class="section section--top0">
      <div class="wrap">
        {shootCards.length > 0 ? (
          <div class="work work--2">
            {shootCards.map(({ shoot, cover }, index) => {
              const resolvedCoverIndex = shoot.photos.findIndex((photo) => photo.src === shoot.cover.src);
              const date = formatShootDate(shoot.date);
              const meta = [shoot.type, shoot.location, date].filter(Boolean).join(' · ');
              return (
                <a class="work-card" href={`/portfolio/${shoot.slug}`} data-reveal style={`--reveal-delay:${(index % 2) * 90}ms`}>
                  <div class="work-card__media">
                    <img
                      src={cover.src}
                      loading={index < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                      width={cover.width}
                      height={cover.height}
                      alt={photoAlt(shoot, Math.max(0, resolvedCoverIndex), settings.brand_name)}
                    />
                  </div>
                  <div class="work-card__foot">
                    <div>
                      <h2 class="work-card__title">{shoot.title}</h2>
                      <p class="work-card__meta">{meta}</p>
                    </div>
                    <span class="work-card__n">{shoot.photos.length} foto's</span>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="empty">
            <h2>{page.empty.title}</h2>
            <p>{page.empty.text}</p>
          </div>
        )}
      </div>
    </section>

    <ContentCta content={page.cta} />
  </main>
</BaseLayout>
