---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatShootDate, getPublishedShoots, photoAlt, preparePhoto, type Shoot } from '../../data/shoots';

export async function getStaticPaths() {
  const shoots = await getPublishedShoots();
  return shoots.map((shoot, index) => ({
    params: { slug: shoot.slug },
    props: {
      shoot,
      nextShoot: shoots.length > 1 ? shoots[(index + 1) % shoots.length] : null,
    },
  }));
}

interface Props {
  shoot: Shoot;
  nextShoot: Shoot | null;
}

const { shoot, nextShoot } = Astro.props;
const renderedPhotos = await Promise.all(shoot.photos.map(preparePhoto));
const formattedDate = formatShootDate(shoot.date);
const description = `${shoot.title} — ${shoot.photos.length} foto's van ${shoot.type.toLowerCase()} in ${shoot.location}, gefotografeerd door Sideline Action.`;
const ratios = ['ratio--45', 'ratio--34', 'ratio--23', 'ratio--45', 'ratio--34'];
const frameFor = (index: number) => {
  if (index % 11 === 0) {
    return {
      className: `gal__item--feature${index % 22 === 0 ? '' : ' gal__item--right'}`,
      ratio: 'ratio--45',
    };
  }
  return {
    className: index % 4 === 2 ? 'gal__item--offset' : '',
    ratio: ratios[index % ratios.length],
  };
};
---

<BaseLayout title={`${shoot.title} | Sideline Action — Sportfotografie Antwerpen`} description={description} image={renderedPhotos[0].src}>
  <main id="main">
    <section class="page-head">
      <div class="wrap">
        <nav class="crumb" aria-label="Kruimelpad">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/portfolio">Portfolio</a><span aria-hidden="true">/</span><span aria-current="page">{shoot.title}</span>
        </nav>
        <h1 class="page-head__title">{shoot.title}</h1>
        <p class="lead page-head__lead">{shoot.intro}</p>
        <div class="mt-4">
          <ul class="contact-list" style="border-top:1px solid var(--line)">
            <li><span class="row"><span class="k">Type</span><span class="v">{shoot.type}</span><span></span></span></li>
            <li><span class="row"><span class="k">Locatie</span><span class="v">{shoot.location}</span><span></span></span></li>
            {formattedDate && <li><span class="row"><span class="k">Datum</span><span class="v">{formattedDate}</span><span></span></span></li>}
            <li><span class="row"><span class="k">Foto's</span><span class="v">{shoot.photos.length}</span><span></span></span></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--top0">
      <div class="wrap">
        <div class="gal" data-gallery>
          {shoot.photos.map((_, index) => {
            const frame = frameFor(index);
            const renderedPhoto = renderedPhotos[index];
            const src = renderedPhoto.src;
            const alt = photoAlt(shoot, index);
            return (
              <button
                class={`gal__item ${frame.className}`}
                type="button"
                data-lightbox-item
                data-full-src={src}
                data-alt={alt}
                data-caption={`${shoot.title} · ${shoot.location}`}
                aria-label={`Foto ${index + 1} van ${shoot.photos.length} groter bekijken`}
              >
                <span class={`gal__frame ratio ${frame.ratio}`}>
                  <img src={src} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" width={renderedPhoto.width} height={renderedPhoto.height} alt={alt} />
                </span>
                <span class="gal__n">{String(index + 1).padStart(3, '0')}</span>
              </button>
            );
          })}
        </div>
      </div>
    </section>

    {nextShoot && (
      <section class="section section--half section--top0">
        <div class="wrap">
          <hr class="rule" />
          <div class="mt-3"><a class="link" href={`/portfolio/${nextShoot.slug}`}>Volgende shoot: {nextShoot.title}</a></div>
        </div>
      </section>
    )}

    <section class="section">
      <div class="wrap">
        <div class="split split--top">
          <div>
            <p class="label label--rule">Boeken</p>
            <h2 class="h2 mt-2" data-reveal>Zin in wedstrijdbeelden zoals deze?</h2>
            <p class="muted mt-3 measure" data-reveal="fade">Laat weten of het om een clubreportage of één speler gaat en ik neem zo snel mogelijk contact op.</p>
            <div class="btn-row mt-4" data-reveal>
              <a class="btn btn--solid" href="/boeken"><span>Boek een shoot</span></a>
              <a class="link" href="/aanbod">Bekijk het aanbod</a>
            </div>
          </div>
          <div data-reveal="mask">
            <div class="ratio ratio--45 zoom">
              <img src="/assets/img/site/band-cta.webp" alt="Twee spelers in duel om de bal tijdens een voetbalwedstrijd in Antwerpen — Sideline Action" width="900" height="1350" loading="lazy" decoding="async" />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
