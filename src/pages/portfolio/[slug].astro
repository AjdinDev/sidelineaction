---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCta from '../../components/ContentCta.astro';
import { getPortfolioPage, getSiteSettings, resolveSiteTokens } from '../../data/content';
import { formatShootDate, getPublishedShoots, photoAlt, preparePhoto, type Shoot } from '../../data/shoots';

export async function getStaticPaths() {
  const shoots = await getPublishedShoots();
  return shoots.map((shoot, index) => ({
    params: { slug: shoot.slug },
    props: {
      shoot,
      nextShoot: shoots.length > 1 ? shoots[(index + 1) % shoots.length] : null,
    },
  }));
}

interface Props {
  shoot: Shoot;
  nextShoot: Shoot | null;
}

const { shoot, nextShoot } = Astro.props;
const [renderedPhotos, settings, rawPage] = await Promise.all([
  Promise.all(shoot.photos.map(preparePhoto)),
  getSiteSettings(),
  getPortfolioPage(),
]);
const page = resolveSiteTokens(rawPage, settings);
const formattedDate = formatShootDate(shoot.date);
const description = `${shoot.title} — ${shoot.photos.length} foto's van ${shoot.type.toLowerCase()} in ${shoot.location}, gefotografeerd door ${settings.brand_name}.`;
const ratios = ['ratio--45', 'ratio--34', 'ratio--23', 'ratio--45', 'ratio--34'];
const frameFor = (index: number) => {
  if (index % 11 === 0) {
    return {
      className: `gal__item--feature${index % 22 === 0 ? '' : ' gal__item--right'}`,
      ratio: 'ratio--45',
    };
  }
  return {
    className: index % 4 === 2 ? 'gal__item--offset' : '',
    ratio: ratios[index % ratios.length],
  };
};
---

<BaseLayout title={`${shoot.title} | ${settings.brand_name} — Sportfotografie Antwerpen`} description={description} image={renderedPhotos[0].src}>
  <main id="main">
    <section class="page-head">
      <div class="wrap">
        <nav class="crumb" aria-label="Kruimelpad">
          <a href="/">{page.detail.home_label}</a><span aria-hidden="true">/</span><a href="/portfolio">{page.detail.portfolio_label}</a><span aria-hidden="true">/</span><span aria-current="page">{shoot.title}</span>
        </nav>
        <h1 class="page-head__title">{shoot.title}</h1>
        <p class="lead page-head__lead">{shoot.intro}</p>
        <div class="mt-4">
          <ul class="contact-list" style="border-top:1px solid var(--line)">
            <li><span class="row"><span class="k">{page.detail.type_label}</span><span class="v">{shoot.type}</span><span></span></span></li>
            <li><span class="row"><span class="k">{page.detail.location_label}</span><span class="v">{shoot.location}</span><span></span></span></li>
            {formattedDate && <li><span class="row"><span class="k">{page.detail.date_label}</span><span class="v">{formattedDate}</span><span></span></span></li>}
            <li><span class="row"><span class="k">{page.detail.photos_label}</span><span class="v">{shoot.photos.length}</span><span></span></span></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--top0">
      <div class="wrap">
        <div class="gal" data-gallery>
          {shoot.photos.map((_, index) => {
            const frame = frameFor(index);
            const renderedPhoto = renderedPhotos[index];
            const src = renderedPhoto.src;
            const alt = photoAlt(shoot, index, settings.brand_name);
            return (
              <button
                class={`gal__item ${frame.className}`}
                type="button"
                data-lightbox-item
                data-full-src={src}
                data-alt={alt}
                data-caption={`${shoot.title} · ${shoot.location}`}
                aria-label={`Foto ${index + 1} van ${shoot.photos.length} groter bekijken`}
              >
                <span class={`gal__frame ratio ${frame.ratio}`}>
                  <img src={src} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" width={renderedPhoto.width} height={renderedPhoto.height} alt={alt} />
                </span>
                <span class="gal__n">{String(index + 1).padStart(3, '0')}</span>
              </button>
            );
          })}
        </div>
      </div>
    </section>

    {nextShoot && (
      <section class="section section--half section--top0">
        <div class="wrap">
          <hr class="rule" />
          <div class="mt-3"><a class="link" href={`/portfolio/${nextShoot.slug}`}>{page.detail.next_label}: {nextShoot.title}</a></div>
        </div>
      </section>
    )}

    <ContentCta content={page.detail_cta} />
  </main>
</BaseLayout>
