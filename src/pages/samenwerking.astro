---
import ContentCta from '../components/ContentCta.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollaborationPage, getSiteSettings, resolveSiteTokens } from '../data/content';

const settings = await getSiteSettings();
const page = resolveSiteTokens(await getCollaborationPage(), settings);
---

<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image}>
  <main id="main">
    <PageHeader {...page.header} />

    <section class="section section--top0">
      <div class="wrap">
        <ul class="terms" data-reveal="fade">
          {page.terms.map((term) => (
            <li><span class="k">{term.title}</span><span class="v">{term.text}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split split--top">
          <div>
            <p class="label label--rule">{page.privacy.label}</p>
            <h2 class="h2 mt-2" data-reveal>{page.privacy.title}</h2>
          </div>
          <div data-reveal="fade">
            <p class="muted measure">{page.privacy.intro}</p>
            <ul class="checks mt-3">
              {page.privacy.items.map((item) => (
                <li><span class="tick" aria-hidden="true">—</span><span class="muted">{item}</span></li>
              ))}
            </ul>
            <p class="muted mt-3 measure">{page.privacy.closing}</p>
          </div>
        </div>
      </div>
    </section>

    <ContentCta content={page.cta} />
  </main>
</BaseLayout>
